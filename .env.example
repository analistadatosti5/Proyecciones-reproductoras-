# Copie este archivo como .env y complete los valores.
# El archivo .env contiene credenciales: NO lo suba al repositorio (.gitignore ya lo excluye).

# Usuario y clave comunes a todas las bases.
# Si una base necesita otras credenciales, defina <PREFIJO>_USER y <PREFIJO>_PASSWORD
# (por ejemplo ANALITICA_USER / ANALITICA_PASSWORD).
DB_USER=''
DB_PASSWORD=''
DB_PORT=5432

# Estándares: core.standard_header y core.standard_data
AVI_GRANJAS_HOST=192.168.13.93
AVI_GRANJAS_DB=avi_granjas

# Nombres de alimento: public.materials
COMMERCIAL_BI_HOST=192.168.13.93
COMMERCIAL_BI_DB=commercial_bi

# Granjas reproductoras: public.mnl_broiler_breeder_farms y public.mnl_broiler_breeder_house_details
ANALITICA_HOST=192.168.13.84
ANALITICA_DB=analitica

# Datos reales de los lotes (SQL Server): EncasetamientoCabecera, EncasetamientoDetalle y DiaReproductora.
# Tiene usuario y clave propios; el puerto por defecto es 1433 (GRANJAS_BI_PORT para cambiarlo).
# Opcional: GRANJAS_BI_DRIVER para forzar un controlador ODBC (por defecto el primero instalado de
# "ODBC Driver 18 for SQL Server", "ODBC Driver 17 for SQL Server" y "SQL Server", que trae Windows).
GRANJAS_BI_HOST=192.168.13.32
GRANJAS_BI_DB=Granjas_BI
GRANJAS_BI_USER=''
GRANJAS_BI_PASSWORD=''
